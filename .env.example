# ======================
# FRONTEND CONFIGURATION
# ======================

# Wallet Connect Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_ID=your_project_id_here

# Alchemy API Key (for RPC endpoints)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key_here
ALCHEMY_API_KEY=your_alchemy_key_here

# AgentPay Escrow Contract Addresses (per chain)
NEXT_PUBLIC_ESCROW_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_ADDRESS_BASE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_ADDRESS_ARBITRUM=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_ADDRESS_OPTIMISM=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_ADDRESS_POLYGON=0x0000000000000000000000000000000000000000

# ======================
# SMART CONTRACT DEPLOYMENT
# ======================

# Deployer private key (DO NOT COMMIT)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
OPTIMISM_API_KEY=your_optimism_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ======================
# WEBHOOK CONFIGURATION
# ======================

# Webhook secret for signature verification
WEBHOOK_SECRET=your_webhook_secret_here
